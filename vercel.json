{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/avaliar",
      "destination": "https://search.google.com/local/writereview?placeid=ChIJxSDBg5CIBQwRGJ01WCjDI6c",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(img|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}